# Copy to .env and fill in from Firebase console > Project settings > Your apps (Web).
# These web config values are not secrets, but .env is still gitignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check. Local dev: leave RECAPTCHA key empty and set DEBUG=true; the console prints a debug token
# that must be registered in Firebase console > App Check > Apps > Manage debug tokens.
# NEVER commit a debug token. For the public demo use a reCAPTCHA Enterprise / v3 site key instead.
VITE_APPCHECK_DEBUG=true
VITE_RECAPTCHA_SITE_KEY=
